{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cliprtc",
  "version": "0.1.2",
  "identifier": "cn.imlete.tauri.cliprtc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Settings",
        "label": "settings",
        "url": "/settings",
        "width": 640,
        "height": 480,
        "center": true,
        "visible": false,
        "resizable": false,
        "transparent": true,
        "maximizable": false,
        "hiddenTitle": true,
        "skipTaskbar": false,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
